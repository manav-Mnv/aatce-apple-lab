# ── Backend (server-only) ────────────────────────────────────────────────
# Apps Script web app URL and the ADMIN_SECRET Script Property.
# For local development: `node backend/dev/server.js` and use the values below.
APPS_SCRIPT_URL=http://localhost:8787/exec
ADMIN_SECRET=dev-admin-secret

# ── Firebase Authentication (Google sign-in) ─────────────────────────────
# Leave empty during local development: sign-in is skipped (never in production,
# where the API refuses every request until these are set).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Who may sign in: a whole email domain and/or a comma-separated list of emails.
NEXT_PUBLIC_ADMIN_EMAIL_DOMAIN=paruluniversity.ac.in
ADMIN_EMAILS=

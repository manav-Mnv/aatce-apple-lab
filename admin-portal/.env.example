# ── Backend (server-only) ────────────────────────────────────────────────
# Supabase project URL and publishable key (Supabase → Project Settings → API Keys),
# and the admin secret (Supabase → Integrations → Vault → aatce_admin_secret).
SUPABASE_URL=https://mlwbcifxunliyvxxfblo.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YzKz9KDj3humCQ5Vu1Da2Q_eCZnTH0U
ADMIN_SECRET=

# ── Firebase Authentication (Google sign-in) ─────────────────────────────
# Leave empty during local development: sign-in is skipped (never in production,
# where the API refuses every request until these are set).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Who may sign in: a whole email domain and/or a comma-separated list of emails.
NEXT_PUBLIC_ADMIN_EMAIL_DOMAIN=paruluniversity.ac.in
ADMIN_EMAILS=
